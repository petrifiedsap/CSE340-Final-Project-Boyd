<%- include('../partials/header') %>
<main>
    <h1>Mulch</h1>
    <p>These are the beautiful things!</p>
    // TODO all of this needs to be fixed once the database is set up

    <div class="course-list">
        <% Object.values(courses).forEach(course => { %>
            <div class="course-card">
                <h3><a href="/catalog/<%= course.slug %>"><%= course.courseCode %></a></h3>
                <p class="course-id"><%= course.name %> • <%= course.creditHours %> credits</p>
                <p class="course-description"><%= course.description %></p>
            </div>
        <% }); %>
    </div>
</main>
<%- include('../partials/footer') %>