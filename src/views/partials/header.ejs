<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>scout mulch site</title>
    <link type="text/css" rel="stylesheet" href="/css/main.css">
    <% if (NODE_ENV.includes('dev')) { %>
    <script>
        // Get the current hostname and port from the browser
        const host = window.location.hostname;
        const currentPort = window.location.port;

        // Calculate WebSocket port (current port + 1)
        const wsPort = currentPort ? (parseInt(currentPort) + 1) : 3001;

        // Create WebSocket connection using dynamic hostname and port
        const ws = new WebSocket(`ws://${host}:${wsPort}`);
        ws.onclose = () => {
            setTimeout(() => location.reload(), 2000);
        };
    </script>
    <% } %>
</head>
<body>
    <div id="content">
    <header>
        <a class="nav_link" href="/about_us">About our Troop</a>
        <a class="nav_link" href="/about_mulch">Why Mulch?</a>
        <a class="logo_link" href="/">
            <img class="logo" src="/images/scout_logo.PNG" alt="Troop 27 logo">
        </a>
        <a class="order" href="http://planoscouts27.com/">Order Now!</a>     
    </header>